TEST_EMAIL=
TEST_PASS=
TEST_COMPANY=

# Konto nie-admin do testu izolacji tenantow (tests/api/tenant-isolation-test.js)
TEST_EMAIL_NONADMIN=
TEST_PASS_NONADMIN=
TEST_COMPANY_NONADMIN=gcon

# Token Cloudflare do tools/cf-ocr-test.js (test OCR na jednym dowodzie).
# Utworz: Dashboard -> My Profile -> API Tokens -> Create Token -> Custom token
# Uprawnienie: Account -> Workers AI -> Read.   TYLKO TO JEDNO.
# Taki token nie ruszy Workera, D1, R2 ani DNS — moze wylacznie wywolac model.
# Po tescie mozesz go skasowac jednym klikiem w panelu.
CLOUDFLARE_API_TOKEN=

# Katalog z dowodami rejestracyjnymi — uzywany, gdy uruchomisz cf-ocr-test.js
# BEZ podania sciezki do pliku (narzedzie samo wybierze jeden obraz).
DR_FOLDER=

# Sekret serwisu OCR na Cloud Run (ta sama wartosc co Cloudflare secret
# OCR_PYTHON_SECRET — patrz wrangler.toml). Uzywane przez
# tools/dr-ocr-batch-cloudrun.js do wywolan BEZPOSREDNICH (z pominieciem
# limitu 8s Workera), nie przez sam Worker.
OCR_PYTHON_SECRET=
OCR_PYTHON_URL=https://ocr-service-346215975089.europe-west1.run.app
