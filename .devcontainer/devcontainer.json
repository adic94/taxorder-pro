{
  "name": "TaxOrder Pro — Dev Environment",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bullseye",

  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-playwright.playwright",
        "bradlc.vscode-tailwindcss",
        "formulahendry.auto-rename-tag",
        "christian-kohler.path-intellisense",
        "anthropics.claude-code"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },

  "postCreateCommand": "npm install && npx playwright install chromium --with-deps",

  "forwardPorts": [3000, 8787],

  "remoteEnv": {
    "CLOUDFLARE_ACCOUNT_ID": "bb17d1d7a681084f377fd23989f29d7f"
  },

  "mounts": [],

  "portsAttributes": {
    "3000": {
      "label": "Frontend lokalny",
      "onAutoForward": "openBrowser"
    },
    "8787": {
      "label": "Wrangler dev (Worker)",
      "onAutoForward": "notify"
    }
  },

  "postStartCommand": "echo '🚀 TaxOrder Pro ready. Run: npx http-server . -p 3000 or wrangler dev'"
}
