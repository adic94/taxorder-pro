{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "globals": {
    "esc": "readonly",
    "toast": "readonly",
    "showToast": "readonly",
    "t": "readonly",
    "vehs": "writable",
    "selected": "writable",
    "taxpayer": "writable",
    "currentCompanyId": "writable",
    "COMPANIES": "readonly",
    "TaxEngine": "readonly",
    "TaxOrderTests": "readonly",
    "GminyRates": "readonly",
    "VehicleDictionaries": "readonly",
    "I18n": "readonly",
    "UserPrefs": "readonly",
    "DT1Generator": "readonly",
    "FleetReports": "readonly",
    "OcrFuelInvoices": "readonly",
    "TaxOrderFleetCloud": "readonly",
    "TaxOrderVehicleDetail": "readonly",
    "TerytAutocomplete": "readonly",
    "ROLE_TABS": "readonly",
    "catDefs": "readonly",
    "calcTax": "readonly",
    "getCat": "readonly",
    "getRate": "readonly",
    "fmt2": "readonly",
    "setV": "readonly",
    "showPage": "readonly",
    "refreshAll": "readonly",
    "renderVeh": "readonly",
    "renderDash": "readonly",
    "renderFormularze": "readonly",
    "updateCounters": "readonly",
    "vehGoPage": "readonly",
    "clearColFilters": "readonly",
    "applyRoleAccess": "readonly",
    "getCurrentCompany": "readonly",
    "setTaxOrderVehicles": "readonly",
    "openKartaModal": "readonly",
    "openUpdateModal": "readonly",
    "showManualForm": "readonly",
    "loadAssets": "readonly",
    "loadZXing": "readonly",
    "tryAztecFromCanvas": "readonly",
    "_rotateCanvas": "readonly",
    "_getDashConfig": "readonly",
    "_applyDashConfig": "readonly",
    "XLSX": "readonly",
    "ZXing": "readonly",
    "Chart": "readonly",
    "L": "readonly",
    "PDFLib": "readonly",
    "QRCode": "readonly",
    "Tesseract": "readonly",
    "fontkit": "readonly",
    "html2canvas": "readonly",
    "pdfjsLib": "readonly"
  },
  "rules": {
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "no-undef": "error",
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "prefer-const": "warn",
    "no-var": "error",
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-new-func": "error",
    "no-script-url": "error",
    "no-prototype-builtins": "warn",
    "prefer-template": "warn"
  },
  "ignorePatterns": [
    "node_modules/",
    "tools/api-explorer/",
    "tools/api-explorer/node_modules/",
    "*.min.js"
  ]
}
