{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "checkJs": true,
    "allowJs": true,
    "strict": false,
    "noImplicitAny": false,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "baseUrl": ".",
    "paths": {}
  },
  "include": [
    "app.js",
    "modules/**/*.js",
    "worker/**/*.js",
    "tests/**/*.js",
    "tools/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "**/*.min.js"
  ]
}
